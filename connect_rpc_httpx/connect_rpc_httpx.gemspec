# frozen_string_literal: true

require_relative "lib/connect_rpc_httpx/version"

Gem::Specification.new do |spec|
  spec.name = "connect_rpc_httpx"
  spec.version = ConnectRpcHttpx::VERSION
  spec.authors = ["IVRy Inc."]
  spec.email = ["arch@ivry.jp"]
  spec.summary = "Connect RPC client runtime built on httpx."
  spec.description = "The runtime for Ruby clients generated by protoc-gen-connect-ruby: " \
    "speaks the Connect protocol over a thread-safe, persistent httpx session."
  spec.homepage = "https://github.com/ivry-inc/connect_rpc_httpx"
  spec.license = "Apache-2.0"
  spec.required_ruby_version = ">= 3.4"

  spec.metadata = {
    "allowed_push_host" => "https://rubygems.org",
    "homepage_uri" => spec.homepage,
    "source_code_uri" => "#{spec.homepage}/tree/main/connect_rpc_httpx",
    "rubygems_mfa_required" => "true",
  }

  spec.files = Dir["lib/**/*.rb", "sig/**/*.rbs", "README.md", "LICENSE"]
  spec.require_paths = ["lib"]

  spec.add_dependency "base64"
  spec.add_dependency "google-protobuf", "~> 4.26"
  spec.add_dependency "httpx", "~> 1.4"
end
