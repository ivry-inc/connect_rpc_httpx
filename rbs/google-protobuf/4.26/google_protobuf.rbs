# The google-protobuf 4.x surface both gems use. Hand-written because the gem ships no
# signatures and ruby/gem_rbs_collection's entry stops at 3.22. Narrow on purpose: every
# declaration here is reached from lib/.
module Google
  module Protobuf
    class Error < StandardError
    end

    class ParseError < Error
    end

    class RepeatedField[T]
      include Enumerable[T]

      def each: () { (T) -> void } -> self
      def to_a: () -> Array[T]
      def empty?: () -> bool
    end

    module MessageExts
      def []: (String field) -> untyped

      module ClassMethods
        def encode: (untyped message, **untyped options) -> String
        def decode: (String bytes, **untyped options) -> untyped
      end
    end

    class AbstractMessage
      include MessageExts
      extend MessageExts::ClassMethods

      # Generated message classes take their fields as keywords, or as one Hash.
      def initialize: (?untyped initial_values, **untyped) -> void
    end

    class Any < AbstractMessage
      def type_url: () -> String
      def value: () -> String
    end

    module Edition
      EDITION_PROTO2: Integer
      EDITION_2024: Integer
    end

    class FileDescriptorProto < AbstractMessage
      def name: () -> String
      def package: () -> String
      def message_type: () -> RepeatedField[DescriptorProto]
      def enum_type: () -> RepeatedField[EnumDescriptorProto]
      def service: () -> RepeatedField[ServiceDescriptorProto]
      def options: () -> FileOptions?
      def source_code_info: () -> SourceCodeInfo?
    end

    class FileOptions < AbstractMessage
      def ruby_package: () -> String
    end

    class DescriptorProto < AbstractMessage
      def name: () -> String
      def field: () -> RepeatedField[FieldDescriptorProto]
      def nested_type: () -> RepeatedField[DescriptorProto]
      def enum_type: () -> RepeatedField[EnumDescriptorProto]
      def options: () -> MessageOptions?
    end

    class MessageOptions < AbstractMessage
      def map_entry: () -> bool
    end

    class FieldDescriptorProto < AbstractMessage
      def name: () -> String
      def number: () -> Integer

      # :TYPE_STRING, :TYPE_MESSAGE, ...
      def type: () -> Symbol

      # :LABEL_OPTIONAL, :LABEL_REPEATED or :LABEL_REQUIRED
      def label: () -> Symbol

      # The fully-qualified name of a message or enum type, such as ".acme.v1.Outer.Inner".
      def type_name: () -> String
    end

    class EnumDescriptorProto < AbstractMessage
      def name: () -> String
      def value: () -> RepeatedField[EnumValueDescriptorProto]
    end

    class EnumValueDescriptorProto < AbstractMessage
      def name: () -> String
    end

    class ServiceDescriptorProto < AbstractMessage
      def name: () -> String

      # The "method" field has no usable accessor, since Object#method shadows it.
      def []: ("method" field) -> RepeatedField[MethodDescriptorProto]
            | ...
    end

    class MethodDescriptorProto < AbstractMessage
      def name: () -> String
      def input_type: () -> String
      def output_type: () -> String
      def client_streaming: () -> bool
      def server_streaming: () -> bool
      def options: () -> MethodOptions?
    end

    class MethodOptions < AbstractMessage
      # :IDEMPOTENCY_UNKNOWN, :NO_SIDE_EFFECTS or :IDEMPOTENT
      def idempotency_level: () -> Symbol
    end

    class SourceCodeInfo < AbstractMessage
      class Location < AbstractMessage
        def path: () -> RepeatedField[Integer]
        def leading_comments: () -> String
      end

      def location: () -> RepeatedField[Location]
    end

    module Compiler
      class CodeGeneratorRequest < AbstractMessage
        def self.decode: (String bytes, **untyped options) -> CodeGeneratorRequest

        def file_to_generate: () -> RepeatedField[String]
        def parameter: () -> String
        def proto_file: () -> RepeatedField[FileDescriptorProto]
      end

      class CodeGeneratorResponse < AbstractMessage
        module Feature
          FEATURE_PROTO3_OPTIONAL: Integer
          FEATURE_SUPPORTS_EDITIONS: Integer
        end

        class File < AbstractMessage
        end
      end
    end
  end
end
